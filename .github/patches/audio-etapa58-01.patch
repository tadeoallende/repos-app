+    /** Panel de soporte: muestra el estado del audio nativo para compartirlo con una captura. */
+    private fun showAudioInfoDialog() {
+        val player = exoPlayer ?: return
+        val summary = PlayerAudioDiagnostics.summarize(player.currentTracks)
+        val report = PlayerAudioDiagnostics.formatReport(
+            channelName = currentChannel?.name,
+            type = currentStreamType,
+            url = currentStreamUrl,
+            summary = summary,
+            // Conservar entre reconexiones de la misma sesión, nunca al cambiar de canal/fuente.
+            lastError = lastAudioError.takeIf { lastAudioErrorGeneration == playerGeneration }
+        )
+        AlertDialog.Builder(this)
+            .setTitle("Info de audio")
+            .setMessage(report)
+            .setPositiveButton("Cerrar", null)
+            .show()
+    }
