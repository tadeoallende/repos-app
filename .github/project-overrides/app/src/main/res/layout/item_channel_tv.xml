<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/channel_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:minHeight="50dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_channel_row_nebula"
    android:elevation="0dp"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/channel_number"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/channel_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:padding="4dp"
        android:background="@drawable/bg_channel_logo_container"
        android:contentDescription="Logo del canal" />

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/options_indicator"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/nebula_secondary"
        android:visibility="gone"
        android:layout_marginEnd="5dp"
        android:contentDescription="Opciones del canal" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_play"
        android:tint="@color/nebula_secondary"
        android:contentDescription="@null" />

</LinearLayout>
