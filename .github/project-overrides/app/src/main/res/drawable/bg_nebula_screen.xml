<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#080D1B"
                android:centerColor="#0B1121"
                android:endColor="#11182B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="720dp"
                android:centerX="92%"
                android:centerY="16%"
                android:startColor="#30264D"
                android:centerColor="#191A37"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="620dp"
                android:centerX="18%"
                android:centerY="92%"
                android:startColor="#15294A"
                android:centerColor="#0D1B35"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
